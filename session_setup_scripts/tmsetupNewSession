# shellcheck source=/dev/null
clear # Clear the terminal exactly ONCE at startup
TMUX_TEMPLATE_FILE="./tmux_template.sh"

# Imports:
#   Some ui decorations (ui_button_printf & border_line)
#   Ansi color file is also imported with this source
ui_decoration() {
  source "../ui_components/ui_components.sh"
  # border_line 50
  border_line
  ui_button_printf "TMUX-Session-Maker"
  printf "\n"
}

# Parameter: string argument
prompt_heading() {
  printf "${bold}${purple}%s ${normal}" "$1"
}

# Returns:
#   user input variable
# Parameters:
#  $1 inserts placeholder text for '-i' (such as adding filepath before the prompt string)
#  $2 prompt string
#  $3 enter a variable name
#  -i insert some text before the prompt, -r not sure why, -n 1 Hotkey,
#  -e gives readline file completion in prompt,
#  -p prompt need the " " with the -p otherwise it wont show the input arrow thingy
prompt_user() {
  read -i "$1" -r -e -p "$2" "$3"
}

# Returns:
#   EDIT_FILE variable
# For conditions to be true to exit out of while loop...
#   EDIT_FILE directory path must exist AND
#   EDIT_FILE must not end with a trailing '/'
get_edit_file() {
  # prompt_heading "Enter File to Edit:"
  prompt_heading "SELECT A FILE TO EDIT:"
  while true; do
    prompt_user "$HOME/coding-practice/" "" EDIT_FILE
    if [[ -d "$(dirname "$EDIT_FILE")" ]] && [[ ! "${EDIT_FILE: -1}" == "/" ]]; then
      break
    fi
  done
}

# Returns:
#   DIRECTORY variable
#   SESSION_NAME variable
#   SESSION_FILE_NAME variable
# Note:
#   need to use echo here or it wont work (it wont get assigned)
build_session_name_variable() {
  # prompt_heading "Enter Session Name:"
  prompt_heading "ENTER A SESSION NAME: "
  DIRECTORY="$(dirname "$EDIT_FILE")"
  SESSION_NAME="$(read -r -p "" SESSION_NAME && echo "$SESSION_NAME")"
  SESSION_FILE_NAME="../session_names/tm${SESSION_NAME}"
}

# -------------- menu setup ----------------------------------
# The next two functions draw out a scrollable menu of options
# for selecting a tmux layout.
# Note:
#   Make sure the names in OPTIONS array are exactly the same
#    as in the tmux_template.sh file.
OPTIONS=("repl_setup" "webdev_setup" "opencode_setup" "Exit")
SELECTED=0
LABEL="SELECT A TMUX LAYOUT:"
LABEL_WIDTH=${#LABEL}

# Calculate the exact column where the menu column must start
# 1-based index: Label length + 1 space for colon + 1 spaces padding
MENU_COLUMN=$((LABEL_WIDTH + 3))
MENU_START_ROW=7

# Returns:
#   A column of options from the above OPTIONS array
#   The first item will be highlighted
draw_menu() {
  # 1. Clear trailing artifacts by explicitly erasing old lines
  # This guarantees the blue background clears completely when moving
  for i in "${!OPTIONS[@]}"; do
    local target_row=$((MENU_START_ROW + i))
    echo -ne "\e[${target_row};1H\e[K"
  done

  # 2. Draw the stationary side label at its fixed row and column
  echo -ne "\e[${MENU_START_ROW};1H${bold}${purple}${LABEL}${normal}"

  # 3. Draw each menu item at its absolute, left-justified column alignment
  for i in "${!OPTIONS[@]}"; do
    local target_row=$((MENU_START_ROW + i))
    echo -ne "\e[${target_row};${MENU_COLUMN}H"

    if [ "$i" -eq "$SELECTED" ]; then
      # The extra spaces inside the background color keep the block uniform
      echo -ne "${BLUE}${white} ▶ ${OPTIONS[$i]} ${normal}"
    else
      echo -ne "   ${OPTIONS[$i]}"
    fi
  done
}

# Returns:
#   selected_tmux_layout Variable
# Calls:
#   draw_menu() is called everytime j/k key pressed and
#   then the 'SELECTED' variable will increment up/down by 1
# Break:
#   The while loop ends when 'Enter' key is pressed.
get_tmux_layout() {
  echo -ne "\e[?25l"             # Hide cursor
  trap 'echo -ne "\e[?25h"' EXIT # Show cursor
  while true; do
    draw_menu
    # IFS= preserves spaces properly
    IFS= read -rsn1 key
    case "$key" in
    "k" | "K")
      if [ "$SELECTED" -gt 0 ]; then ((SELECTED--)); else SELECTED=$((${#OPTIONS[@]} - 1)); fi
      ;;
    "j" | "J")
      if [ "$SELECTED" -lt $((${#OPTIONS[@]} - 1)) ]; then ((SELECTED++)); else SELECTED=0; fi
      ;;
    "") # Enter key
      selected_tmux_layout="${OPTIONS[$SELECTED]}"
      # if [[ $selected_tmux_layout == "Exit" ]]; then
      #   exit 0 # this also kills the terminal so I'm not using for now
      # fi
      break
      ;;
    esac
  done
  printf "\n\n"
  echo -ne "\e[?25h" # show cursor
}

# Returns:
#   TMUX session
# Calls:
#   append_text
get_tmux_session() {
  if [[ -f "${SESSION_FILE_NAME}" ]]; then
    border_line
    printf "The session_file${bold}${italic}${green} %s ${normal}already exists\n" \
      "$(basename "$SESSION_FILE_NAME")"
    source "$SESSION_FILE_NAME"
  else
    append_text
    # nvim -c "norm 4G20| <cr>" "$SESSION_FILE_NAME" # (If you want to edit)
    border_line
    source "$SESSION_FILE_NAME"
  fi
}

# Returns:
#   SESSION_FILE_NAME executable file to start a custom tmux session
# Called by:
#   get_tmux_session
# Not sure if its ok to do chmod inside script. Probably bad.
append_text() {
  source "$TMUX_TEMPLATE_FILE"
  local append_lines=(
    "#!/usr/bin/bash"
    "$(printf "\n")"
    "selected_tmux_layout=\"$selected_tmux_layout\""
    "EDIT_FILE=\"$EDIT_FILE\""
    "DIRECTORY=\"$DIRECTORY\""
    "SESSION_NAME=\"$SESSION_NAME\""
    "$(printf "\n")"
    "# Add additional settings here. Make it your own."
    "$(declare -f "$selected_tmux_layout")"
    "$(printf "\n")"
    "# Can ignore this. It just re-attaches or starts up the above session."
    "$(declare -f reattach_or_start_session)"
    "reattach_or_start_session" # calls the function
  )
  for line in "${append_lines[@]}"; do
    printf "%s\n" "$line" >>"$SESSION_FILE_NAME"
  done
  chmod +x "$SESSION_FILE_NAME"
}

# Returns:
#   This scripts directory path and then cd's into it
#     Need this in order for relative paths to work
get_cwd_for_relative_paths() {
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
  cd "$SCRIPT_DIR" || exit
}

main() {
  get_cwd_for_relative_paths
  ui_decoration
  get_tmux_layout
  get_edit_file
  build_session_name_variable
  get_tmux_session
}
main
